{
  "name": "PulseChat - Real-Time Communication Platform",
  "short_name": "PulseChat",
  "start_url": "/",
  "id": "/",
  "display": "standalone",
  "background_color": "#0a0e17",
  "theme_color": "#0f172a",
  "description": "Production-grade Real-Time Chat Platform with instant messaging, voice notes, media sharing, and presence indicators.",
  "orientation": "portrait-primary",
  "scope": "/",
  "categories": ["social", "communication", "productivity"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Open Chat",
      "short_name": "Chat",
      "description": "Jump straight into your messages",
      "url": "/chat",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Search Users",
      "short_name": "Find Users",
      "description": "Search user directory and start chats",
      "url": "/users/search",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
